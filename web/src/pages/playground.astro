---
import BaseLayout from '../layouts/BaseLayout.astro';

const starter = `package main

import "fmt"

func main() {
	fmt.Println("hello from GoLearning playground")
	sum := 0
	for i := 1; i <= 5; i++ {
		sum += i
	}
	fmt.Println("sum 1..5 =", sum)
}
`;
---
<BaseLayout title="Playground" description="在瀏覽器寫 Go，後端執行並回傳結果">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-white">Go Playground</h1>
    <p class="mt-2 max-w-2xl text-slate-400">
      在網頁輸入 <code class="text-emerald-300">package main</code> 程式，送到後端 runner 執行並回傳 stdout / stderr。
      僅供學習：有超時、輸出上限，並禁止 <code class="text-emerald-300">net/http</code>、<code class="text-emerald-300">os/exec</code> 等危險能力。
    </p>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="flex min-h-[420px] flex-col rounded-2xl border border-slate-800 bg-slate-900/50">
      <div class="flex items-center justify-between border-b border-slate-800 px-4 py-2">
        <span class="text-sm font-medium text-slate-300">main.go</span>
        <div class="flex gap-2">
          <button id="btn-reset" type="button" class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-300 hover:border-slate-500">重設範例</button>
          <button id="btn-run" type="button" class="rounded-lg bg-emerald-500 px-4 py-1.5 text-xs font-semibold text-slate-950 hover:bg-emerald-400">▶ 執行</button>
        </div>
      </div>
      <textarea
        id="code"
        spellcheck="false"
        class="min-h-[360px] flex-1 resize-y bg-transparent p-4 font-mono text-sm leading-6 text-slate-100 outline-none"
      >{starter}</textarea>
      <p class="border-t border-slate-800 px-4 py-2 text-xs text-slate-500">Ctrl+Enter 執行 · 最長約 5 秒 · 僅標準庫（受限）</p>
    </div>

    <div class="flex min-h-[420px] flex-col rounded-2xl border border-slate-800 bg-slate-950">
      <div class="flex items-center justify-between border-b border-slate-800 px-4 py-2">
        <span class="text-sm font-medium text-slate-300">輸出</span>
        <span id="meta" class="text-xs text-slate-500">尚未執行</span>
      </div>
      <pre id="output" class="flex-1 overflow-auto whitespace-pre-wrap p-4 font-mono text-sm text-slate-200">按「執行」送出程式到後端…</pre>
    </div>
  </div>

  <section class="mt-10 rounded-2xl border border-slate-800 bg-slate-900/40 p-5 text-sm text-slate-400">
    <h2 class="font-semibold text-slate-200">使用說明</h2>
    <ul class="mt-3 list-disc space-y-1 pl-5">
      <li>Docker：網站 <code class="text-emerald-300">:8088</code> 會把 <code class="text-emerald-300">/api/run</code> 轉到 runner 服務。</li>
      <li>本機開發：先啟動 runner（預設 <code class="text-emerald-300">:8091</code>），或設 <code class="text-emerald-300">window.__RUNNER__</code>。</li>
      <li>不適合當公開多租戶裁判系統；僅內網／學習用途。</li>
    </ul>
  </section>
</BaseLayout>

<script define:vars={{ starter }}>
  const codeEl = document.getElementById('code');
  const outEl = document.getElementById('output');
  const metaEl = document.getElementById('meta');
  const btnRun = document.getElementById('btn-run');
  const btnReset = document.getElementById('btn-reset');

  function runnerURL() {
    if (typeof window !== 'undefined' && window.__RUNNER__) return window.__RUNNER__;
    // Same origin proxy (Docker nginx) or local fallback
    return '/api/run';
  }

  async function runCode() {
    const code = codeEl.value;
    btnRun.disabled = true;
    btnRun.textContent = '執行中…';
    outEl.textContent = '執行中，請稍候…';
    metaEl.textContent = '…';
    const t0 = performance.now();
    try {
      const res = await fetch(runnerURL(), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, timeout_sec: 5 }),
      });
      const data = await res.json();
      const parts = [];
      if (data.stdout) parts.push(data.stdout);
      if (data.stderr) parts.push(data.stderr);
      if (data.error) parts.push('[error] ' + data.error);
      if (data.truncated) parts.push('[output truncated]');
      outEl.textContent = parts.join('') || '(無輸出)';
      outEl.className = 'flex-1 overflow-auto whitespace-pre-wrap p-4 font-mono text-sm ' +
        (data.ok ? 'text-emerald-200' : 'text-amber-200');
      metaEl.textContent = `exit=${data.exit_code ?? '?'} · ${data.duration_ms ?? Math.round(performance.now() - t0)} ms · HTTP ${res.status}`;
    } catch (e) {
      outEl.textContent = '無法連到 runner：' + (e && e.message ? e.message : e) +
        '\n\n請確認 Docker 有啟動 runner，或本機 go run ./services/runner';
      outEl.className = 'flex-1 overflow-auto whitespace-pre-wrap p-4 font-mono text-sm text-red-300';
      metaEl.textContent = '連線失敗';
    } finally {
      btnRun.disabled = false;
      btnRun.textContent = '▶ 執行';
    }
  }

  btnRun.addEventListener('click', runCode);
  btnReset.addEventListener('click', () => {
    codeEl.value = starter;
    outEl.textContent = '已重設範例。';
    metaEl.textContent = '尚未執行';
  });
  codeEl.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      runCode();
    }
  });
</script>
