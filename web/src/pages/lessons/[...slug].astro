---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarkdownBody from '../../components/MarkdownBody.astro';
import ExamplePanel from '../../components/ExamplePanel.astro';
import { getAllLessons, getLessonByLessonId } from '../../lib/lessons';
import { loadExampleFiles } from '../../lib/examples';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return getAllLessons().map((l) => ({
    params: { slug: l.slug },
    props: { lesson: l },
  }));
}

const { lesson } = Astro.props;
const prev = lesson.prev ? getLessonByLessonId(lesson.prev) : undefined;
const next = lesson.next ? getLessonByLessonId(lesson.next) : undefined;
const exampleFiles = lesson.example ? loadExampleFiles(lesson.example) : [];
---
<BaseLayout title={`${lesson.lessonId} ${lesson.title}`} description={lesson.description}>
  <div class="mb-8">
    <p class="text-sm text-emerald-500/90">{lesson.volume.toUpperCase()} · {lesson.level.toUpperCase()} · {lesson.status}</p>
    <h1 class="mt-2 text-3xl font-bold text-white sm:text-4xl">{lesson.lessonId} · {lesson.title}</h1>
    <p class="mt-3 text-slate-400">{lesson.description}</p>
    {lesson.example && (
      <p class="mt-3 rounded-lg border border-slate-800 bg-slate-900/60 px-3 py-2 text-sm text-slate-300">
        範例路徑：<code class="text-emerald-300">{lesson.example}</code>
        <span class="text-slate-500"> · 完整原始碼在本頁下方</span>
      </p>
    )}
    {lesson.tags?.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {lesson.tags.map((t) => (
          <span class="rounded-full border border-slate-700 px-2 py-0.5 text-xs text-slate-400">{t}</span>
        ))}
      </div>
    )}
  </div>

  <div class="rounded-2xl border border-slate-800 bg-slate-900/30 px-5 py-2 sm:px-8 sm:py-4">
    <MarkdownBody content={lesson.body} />
  </div>

  {lesson.example && (
    <ExamplePanel examplePath={lesson.example} files={exampleFiles} />
  )}

  <nav class="mt-10 flex flex-wrap items-stretch justify-between gap-4 border-t border-slate-800 pt-8">
    {prev ? (
      <a href={url(`lessons/${prev.slug}/`)} class="max-w-[45%] rounded-xl border border-slate-800 px-4 py-3 hover:border-emerald-800">
        <div class="text-xs text-slate-500">上一章</div>
        <div class="text-sm font-medium text-slate-200">{prev.lessonId} {prev.title}</div>
      </a>
    ) : <span />}
    {next ? (
      <a href={url(`lessons/${next.slug}/`)} class="max-w-[45%] rounded-xl border border-slate-800 px-4 py-3 text-right hover:border-emerald-800 ml-auto">
        <div class="text-xs text-slate-500">下一章</div>
        <div class="text-sm font-medium text-slate-200">{next.lessonId} {next.title}</div>
      </a>
    ) : <span />}
  </nav>
</BaseLayout>
