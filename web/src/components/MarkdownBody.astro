---
import { marked } from 'marked';
import hljs from 'highlight.js/lib/core';
import go from 'highlight.js/lib/languages/go';
import bash from 'highlight.js/lib/languages/bash';
import json from 'highlight.js/lib/languages/json';
import plaintext from 'highlight.js/lib/languages/plaintext';
import python from 'highlight.js/lib/languages/python';
import typescript from 'highlight.js/lib/languages/typescript';
import yaml from 'highlight.js/lib/languages/yaml';
import 'highlight.js/styles/github-dark.css';

hljs.registerLanguage('go', go);
hljs.registerLanguage('bash', bash);
hljs.registerLanguage('shell', bash);
hljs.registerLanguage('sh', bash);
hljs.registerLanguage('json', json);
hljs.registerLanguage('text', plaintext);
hljs.registerLanguage('plaintext', plaintext);
hljs.registerLanguage('python', python);
hljs.registerLanguage('py', python);
hljs.registerLanguage('ts', typescript);
hljs.registerLanguage('typescript', typescript);
hljs.registerLanguage('yaml', yaml);
hljs.registerLanguage('yml', yaml);

interface Props {
  content: string;
}

const { content } = Astro.props;

const renderer = new marked.Renderer();
const originalCode = renderer.code.bind(renderer);
renderer.code = function ({ text, lang }: { text: string; lang?: string; escaped?: boolean }) {
  const language = (lang || 'plaintext').split(/\s+/)[0];
  if (hljs.getLanguage(language)) {
    const highlighted = hljs.highlight(text, { language }).value;
    return `<pre class="hljs"><code class="language-${language}">${highlighted}</code></pre>`;
  }
  const highlighted = hljs.highlightAuto(text).value;
  return `<pre class="hljs"><code>${highlighted}</code></pre>`;
};

// Keep default link behavior but open external in new tab
const originalLink = renderer.link.bind(renderer);
renderer.link = function (args) {
  const html = originalLink(args);
  if (args.href?.startsWith('http')) {
    return html.replace('<a ', '<a target="_blank" rel="noopener noreferrer" ');
  }
  return html;
};

// silence unused if bind changes
void originalCode;

marked.setOptions({
  gfm: true,
  breaks: false,
  renderer,
});

const html = marked.parse(content, { async: false }) as string;
---
<article class="lesson-md" set:html={html} />

<style is:global>
  .lesson-md {
    color: rgb(203 213 225);
    line-height: 1.75;
    font-size: 1rem;
  }
  .lesson-md > *:first-child {
    margin-top: 0;
  }
  .lesson-md h1 {
    margin: 1.5rem 0 1rem;
    font-size: 1.875rem;
    font-weight: 700;
    color: white;
  }
  .lesson-md h2 {
    margin: 2.25rem 0 0.85rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgb(30 41 59);
    font-size: 1.35rem;
    font-weight: 600;
    color: rgb(110 231 183);
  }
  .lesson-md h3 {
    margin: 1.5rem 0 0.6rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: rgb(248 250 252);
  }
  .lesson-md p {
    margin: 0.75rem 0;
  }
  .lesson-md a {
    color: rgb(56 189 248);
    text-decoration: underline;
    text-decoration-color: rgb(3 105 161);
  }
  .lesson-md a:hover {
    color: rgb(125 211 252);
  }
  .lesson-md ul,
  .lesson-md ol {
    margin: 0.75rem 0;
    padding-left: 1.4rem;
  }
  .lesson-md ul {
    list-style: disc;
  }
  .lesson-md ol {
    list-style: decimal;
  }
  .lesson-md li {
    margin: 0.25rem 0;
  }
  .lesson-md strong {
    color: rgb(248 250 252);
    font-weight: 600;
  }
  .lesson-md code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }
  .lesson-md :not(pre) > code {
    border-radius: 0.25rem;
    background: rgb(30 41 59);
    padding: 0.1rem 0.35rem;
    color: rgb(110 231 183);
  }
  .lesson-md pre.hljs,
  .lesson-md pre {
    margin: 1rem 0;
    overflow-x: auto;
    border-radius: 0.75rem;
    border: 1px solid rgb(30 41 59);
    background: #0d1117 !important;
    padding: 1rem;
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .lesson-md pre code {
    background: transparent;
    padding: 0;
    color: inherit;
  }
  .lesson-md table {
    width: 100%;
    margin: 1rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
    display: block;
    overflow-x: auto;
  }
  .lesson-md th,
  .lesson-md td {
    border-bottom: 1px solid rgb(30 41 59);
    padding: 0.55rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .lesson-md th {
    color: rgb(203 213 225);
    font-weight: 600;
  }
  .lesson-md blockquote {
    margin: 1rem 0;
    border-left: 3px solid rgb(16 185 129);
    padding: 0.25rem 0 0.25rem 1rem;
    color: rgb(148 163 184);
  }
  .lesson-md hr {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid rgb(30 41 59);
  }
</style>
